# Copy to .env.local for development, and set the same values in the
# Vercel project's Environment Variables for production.

# Resend (transactional email). Leave unset to fall back to console logging.
RESEND_API_KEY=
CURIO_FROM_EMAIL="Curio <word@yourdomain.com>"

# Upstash Redis (subscriber datastore). Leave unset to fall back to a local
# JSON file at .data/subscribers.json — fine for local dev, NOT for
# production, since serverless filesystems don't persist between requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used to build absolute links in emails (story links, unsubscribe links).
CURIO_SITE_URL=http://localhost:3000

# Shared secret Vercel Cron sends as a bearer token when it hits
# /api/cron/send-daily. Leave unset to skip auth checking (fine locally,
# not recommended once deployed).
CRON_SECRET=

# Secret Auth.js uses to sign session cookies and CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Email address allowed to view /admin (the analytics portal). Must match
# a signed-in account's email exactly. Leave unset to lock /admin out
# entirely (every signed-in visitor gets redirected away).
ADMIN_EMAIL=

# Bluesky auto-post (daily cron). Leave both unset to log the post instead
# of sending — see lib/bluesky.ts. Generate the app password in Bluesky's
# own settings: Settings -> App Passwords (never your account login
# password) — do not commit the real value anywhere.
BLUESKY_IDENTIFIER=curiodaily.bsky.social
BLUESKY_APP_PASSWORD=

# Anthropic API key for the content pipeline's rewrite pass
# (scripts/rewriteEtymology.ts) — only used by that standalone script, never
# by the deployed app itself. Leave unset; the script refuses to run
# without it rather than silently skipping (unlike the daily-send
# fallbacks above, there's no sensible "log what would have been
# generated" stand-in for an LLM rewrite).
ANTHROPIC_API_KEY=
